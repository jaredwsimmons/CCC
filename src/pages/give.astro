---
// Give: the header (with its giving buttons) and the sections come from the Give page in Sanity.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Sections from '../components/sections/Sections.astro';
import { sanityFetch } from '../lib/sanity';
import { fixedPageQuery, settingsQuery } from '../lib/queries';

const [page, settings] = await Promise.all([
  sanityFetch<any>(fixedPageQuery, { id: 'fixed-give' }, Astro.cookies),
  sanityFetch<any>(settingsQuery, {}, Astro.cookies),
]);
---
<Base title={page?.title ?? 'Give'} description={page?.seo?.description}>
  <PageHeader header={page?.header} title={page?.title ?? 'Give'} />
  <Sections list={page?.sections} settings={settings} />
</Base>
