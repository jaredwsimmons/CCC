---
// Community Groups: the header and every section come from the Community Groups page in Sanity (Fixed pages).
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Sections from '../components/sections/Sections.astro';
import { sanityFetch } from '../lib/sanity';
import { fixedPageQuery, settingsQuery } from '../lib/queries';

const [page, settings] = await Promise.all([
  sanityFetch<any>(fixedPageQuery, { id: 'fixed-groups' }, Astro.cookies),
  sanityFetch<any>(settingsQuery, {}, Astro.cookies),
]);
---
<Base title={page?.title ?? 'Community Groups'} description={page?.seo?.description}>
  <PageHeader header={page?.header} title={page?.title ?? 'Community Groups'} />
  <Sections list={page?.sections} settings={settings} />
</Base>
