---
// The homepage keeps its hand-tuned layout; its words and photos come from the Home page
// document in Sanity, and the series, service times and church details from Site Settings.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { site, withBase } from '../data/site';
import { sanityFetch } from '../lib/sanity';
import { homeQuery, settingsQuery } from '../lib/queries';
import { imagePosition, imageUrl } from '../lib/image';
import { shortTimes, telHref } from '../lib/format';

const [home, settings] = await Promise.all([sanityFetch<any>(homeQuery, {}, Astro.cookies), sanityFetch<any>(settingsQuery, {}, Astro.cookies)]);
const hero = home?.hero ?? {};
const welcome = home?.welcome ?? {};
const app = home?.app ?? {};
const series = settings?.currentSeries;
const social = settings?.social ?? {};
const a = settings?.address;
const address = a ? [a.line1, a.city && `${a.city}, ${[a.state, a.zip].filter(Boolean).join(' ')}`].filter(Boolean).join(', ') : '';
const times: string[] = settings?.serviceTimes ?? [];
const titleLines: string[] = (hero.title ?? '').split('\n').filter(Boolean);
const heroImage = imageUrl(hero.image, 2000);
const seriesImage = imageUrl(series?.image, 1200);
const appImage = imageUrl(app.image, 1200);
const ext = { target: '_blank', rel: 'noopener noreferrer' };

const planVisit = `${site.churchCenter.forms.planVisit}?open-in-church-center-modal=true`;
const prayerForm = `${site.churchCenter.forms.prayer}?open-in-church-center-modal=true`;
---
<Base description={home?.seo?.description}>
  {settings?.announcement && (
    <div class="announcement" role="status">
      <div class="wrap">{settings.announcement}</div>
    </div>
  )}

  <!-- Hero — the current site's background video over a real photo fallback.
       The photo paints first (and stays for reduced-motion / JS-off / slow
       connections); the video fades over it once it can play. -->
  <section class="hero home-hero">
    <div class="hero__img">
      {heroImage && <img src={heroImage} alt={hero.image?.alt ?? ''} style={imagePosition(hero.image)} loading="eager" fetchpriority="high" />}
      <video class="hero__video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
        <source src={withBase('/videos/hero.mp4')} type="video/mp4" />
      </video>
    </div>
    <div class="wrap inner">
      {hero.eyebrow && <p class="eyebrow on-dark">{hero.eyebrow}</p>}
      <h1>{titleLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
      <div class="rule" aria-hidden="true"></div>
      {(hero.subline || times.length > 0) && (
        <p class="sub">{hero.subline}{hero.subline && times.length > 0 && ' · '}{times.length > 0 && <b>{times.join(' & ')}</b>}</p>
      )}
      <div class="actions">
        <a class="btn btn--gold btn--lg" href={planVisit}>Plan a Visit</a>
        <a class="btn btn--outline-light btn--lg" href={withBase('/imnew')}>I'm New</a>
      </div>
    </div>
  </section>

  <!-- Blue band — this Sunday -->
  {(times.length > 0 || address) && (
    <div class="band">
      <div class="wrap">
        <span class="dot" aria-hidden="true"></span>
        {times.length > 0 && <span>This Sunday · {shortTimes(times)}</span>}
        {address && <span class="band-addr">{address}</span>}
        {a?.mapsUrl && <a href={a.mapsUrl} {...ext}>Get directions</a>}
      </div>
    </div>
  )}

  <!-- Welcome -->
  <Section eyebrow={welcome.eyebrow} title={welcome.heading} center>
    {welcome.text && <p class="lead measure" data-reveal>{welcome.text}</p>}
    <div class="welcome-actions" data-reveal>
      <a class="btn btn--blue" href={withBase('/imnew')}>I'm New</a>
      <a class="btn btn--outline" href={withBase('/beliefs')}>Learn More</a>
    </div>
  </Section>

  <!-- Current series (Site Settings); hidden when no series is set -->
  {series?.title && (
    <Section variant="navy">
      <div class="split">
        {seriesImage && (
          <div class="photo" data-reveal>
            <img src={seriesImage} alt={series.image?.alt ?? ''} loading="lazy" />
          </div>
        )}
        <div data-reveal>
          <p class="eyebrow on-dark">Current sermon series</p>
          <h2>{series.title}</h2>
          {series.description && <p style="margin-top:0.9rem">{series.description}</p>}
          {(series.watchUrl || series.listenUrl) && (
            <div class="series-actions">
              {series.watchUrl && <a class="btn btn--gold" href={series.watchUrl} {...ext}>Watch Service</a>}
              {series.listenUrl && (
                <a class="btn btn--outline-light" href={series.listenUrl} {...ext}>
                  {series.listenUrl.includes('spotify.com') ? 'Listen on Spotify' : 'Listen'}
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </Section>
  )}

  <!-- App spotlight -->
  <Section variant="white" eyebrow={app.eyebrow} title={app.heading}>
    <div class="split">
      <div data-reveal>
        {app.text && <p class="measure">{app.text}</p>}
        <div class="app-actions">
          <a class="btn btn--blue" href={site.app.ios} {...ext}>App Store</a>
          <a class="btn btn--blue" href={site.app.android} {...ext}>Google Play</a>
          <a class="btn btn--outline" href={site.churchCenter.appSetup} {...ext}>Set up Church Center</a>
        </div>
      </div>
      {appImage && (
        <div class="photo photo--plain" data-reveal>
          <img src={appImage} alt={app.image?.alt ?? ''} loading="lazy" />
        </div>
      )}
    </div>
  </Section>

  <!-- Get in touch — the current site's footer tiles, as cards -->
  <Section eyebrow="Get in touch" title="We're here to listen" center>
    <div class="grid cols-4">
      {settings?.email && (
        <a class="card touch" href={`mailto:${settings.email}`} data-reveal>
          <h3>Email Us</h3>
          <p>Get in touch with us, we're here to listen!</p>
        </a>
      )}
      <a class="card touch" href={prayerForm} data-reveal>
        <h3>Prayer</h3>
        <p>Let us know how we can pray for you.</p>
      </a>
      {social.facebook && (
        <a class="card touch" href={social.facebook} {...ext} data-reveal>
          <h3>Facebook</h3>
          <p>Connect with us and stay up-to-date!</p>
        </a>
      )}
      {social.instagram && (
        <a class="card touch" href={social.instagram} {...ext} data-reveal>
          <h3>Instagram</h3>
          <p>Connect with us and stay up-to-date!</p>
        </a>
      )}
    </div>
    {(address || settings?.phone) && (
      <p class="visit-line" data-reveal>
        {address && <b>{address}</b>}{address && settings?.phone && ' · '}{settings?.phone && <a href={telHref(settings.phone)}>{settings.phone}</a>}
      </p>
    )}
  </Section>
</Base>

<style>
  .announcement { background: var(--gold); color: var(--navy); font-family: var(--display); font-weight: 600; font-size: 0.95rem; }
  .announcement .wrap { padding-block: 0.7rem; text-align: center; }

  .home-hero .inner { padding-block: clamp(4.5rem, 13vw, 8.5rem); }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
  }
  .home-hero h1 { font-size: clamp(2.4rem, 6.5vw, 4.1rem); }
  .home-hero .sub { font-family: var(--display); font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 500; }
  .home-hero .sub b { color: var(--gold); font-weight: 600; }
  .home-hero .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .band-addr { color: rgba(251, 249, 244, 0.75); }
  @media (max-width: 700px) { .band-addr { display: none; } }

  .welcome-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .series-actions, .app-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.4rem; }

  .photo--plain { border: 1px solid var(--hair); }

  .touch { text-decoration: none; display: block; transition: transform 0.16s ease, box-shadow 0.16s ease; }
  .touch:hover { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(25,55,79,0.06), 0 14px 30px -12px rgba(25,55,79,0.18); }
  .touch h3 { color: var(--blue); }
  .visit-line { margin-top: 2rem; color: var(--mid); font-size: 0.98rem; }
</style>
