---
// Media: the header and any sections below come from the Media page in Sanity; the
// messages are built from PUBLIC feeds — no token. (Live PCO Publishing API swaps in here later.)
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import LatestMessage from '../components/LatestMessage.astro';
import Scripturize from '../components/Scripturize.astro';
import Sections from '../components/sections/Sections.astro';
import { sanityFetch } from '../lib/sanity';
import { fixedPageQuery, seriesArtQuery, settingsQuery } from '../lib/queries';
import { imageUrl } from '../lib/image';
import { getYouTubeVideos, getPodcastEpisodes, fmtDuration } from '../lib/feeds';

const [page, settings, seriesImage, videos, episodes] = await Promise.all([
  sanityFetch<any>(fixedPageQuery, { id: 'fixed-media' }, Astro.cookies),
  sanityFetch<any>(settingsQuery, {}, Astro.cookies),
  sanityFetch<any>(seriesArtQuery, {}, Astro.cookies),
  getYouTubeVideos(6),
  getPodcastEpisodes(7),
]);
const latest = episodes[0];
const rest = episodes.slice(1);
const social = settings?.social ?? {};
// Episodes without their own art show the current series art.
const seriesArt = imageUrl(seriesImage, 800);
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const fmtDate = (d: Date | null) =>
  d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
---
<Base title={page?.title ?? 'Media'} description={page?.seo?.description}>
  <PageHeader header={page?.header} title={page?.title ?? 'Media'} />

  <!-- Latest message -->
  {latest && <LatestMessage message={latest} fallbackImage={seriesArt} />}

  <!-- Watch (YouTube) -->
  {videos.length > 0 && (
    <Section eyebrow="Watch" title="Recent services">
      <div class="grid cols-3 vids">
        {videos.map((v) => (
          <a class="vid" href={v.url} target="_blank" rel="noopener noreferrer" data-reveal>
            <div class="vid__thumb">
              <img src={v.thumbnail} alt={v.title} loading="lazy" />
              <span class="vid__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <h3>{v.title}</h3>
            <p class="vid__date">{fmtDate(v.date)}</p>
          </a>
        ))}
      </div>
      {social.youtube && (
        <p class="mt-2" data-reveal>
          <a class="btn btn--outline" href={social.youtube} {...ext}>See all on YouTube</a>
        </p>
      )}
    </Section>
  )}

  <!-- Listen (podcast) -->
  {rest.length > 0 && (
    <Section variant="alt" eyebrow="Listen" title="Sermon podcast">
      <div class="eps">
        {rest.map((e) => (
          <div class="ep" data-reveal>
            {(e.image || seriesArt) && <img class="ep__art" src={e.image || seriesArt} alt="" loading="lazy" />}
            <div class="ep__body">
              <h3><a class="ep__link" href={e.link} target="_blank" rel="noopener noreferrer">{e.title}</a></h3>
              {e.subtitle && <p class="ep__sub"><Scripturize text={e.subtitle} /></p>}
              <p class="ep__meta">{fmtDate(e.date)}{e.duration && ` · ${fmtDuration(e.duration)}`}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="pods mt-2" data-reveal>
        {social.spotify && <a class="btn btn--outline" href={social.spotify} {...ext}>Spotify</a>}
        {social.applePodcasts && <a class="btn btn--outline" href={social.applePodcasts} {...ext}>Apple Podcasts</a>}
        {social.amazonMusic && <a class="btn btn--outline" href={social.amazonMusic} {...ext}>Amazon Music</a>}
      </div>
    </Section>
  )}

  <!-- Fallback if both feeds are unavailable -->
  {videos.length === 0 && episodes.length === 0 && (
    <Section>
      <div class="grid cols-2">
        <div class="card" data-reveal>
          <h3>Watch our worship service</h3>
          <p>Our worship services are streamed live on YouTube each Sunday morning, then uploaded to our channel.</p>
          {social.youtube && <a class="btn btn--blue mt-1" href={social.youtube} {...ext}>Watch on YouTube</a>}
        </div>
        <div class="card" data-reveal>
          <h3>Listen to our sermon podcast</h3>
          <p>You can also find our sermons in podcast form on all major streaming platforms!</p>
          {social.spotify && <a class="btn btn--outline mt-1" href={social.spotify} {...ext}>Listen on Spotify</a>}
        </div>
      </div>
    </Section>
  )}

  <Sections list={page?.sections} settings={settings} />
</Base>

<style>
  /* watch grid */
  .vid { text-decoration: none; display: block; }
  .vid__thumb { position: relative; aspect-ratio: 16/9; border-radius: var(--r); overflow: hidden; border: 1px solid var(--hair); box-shadow: var(--shadow); }
  .vid__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .vid:hover .vid__thumb img { transform: scale(1.04); }
  .vid__play {
    position: absolute; inset: 0; margin: auto; width: 54px; height: 54px;
    display: grid; place-items: center; border-radius: 50%;
    background: rgba(0,82,145,0.9); color: #fff; box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }
  .vid h3 { font-size: 1rem; margin-top: 0.8rem; color: var(--navy); }
  .vid:hover h3 { color: var(--blue); }
  .vid__date { font-size: 0.85rem; color: var(--mid); margin-top: 0.2rem; }

  /* listen list */
  .eps { display: grid; gap: 0.9rem; }
  .ep {
    position: relative;
    display: grid; grid-template-columns: 84px 1fr; gap: 1.1rem; align-items: center;
    background: #fff; border: 1px solid var(--hair); border-radius: var(--r);
    padding: 0.9rem 1.1rem; text-decoration: none; box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .ep:hover { transform: translateY(-1px); box-shadow: 0 2px 4px rgba(25,55,79,0.06), 0 14px 30px -12px rgba(25,55,79,0.18); }
  /* keeps an open scripture tooltip above the next card */
  .ep:hover, .ep:focus-within { z-index: 1; }
  /* the title's link covers the whole card; the scripture reference sits above it */
  .ep__link { color: inherit; text-decoration: none; }
  .ep__link::after { content: ''; position: absolute; inset: 0; border-radius: var(--r); }
  .ep__sub :global(.sref) { z-index: 1; }
  .ep__art { width: 84px; height: 84px; border-radius: 10px; object-fit: cover; }
  .ep__body h3 { font-size: 1.05rem; color: var(--navy); }
  .ep:hover .ep__body h3 { color: var(--blue); }
  .ep__sub { font-size: 0.92rem; color: var(--mid); margin-top: 0.15rem; }
  .ep__meta { font-size: 0.82rem; color: var(--mid); margin-top: 0.3rem; }
  .pods { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  @media (max-width: 480px) { .ep { grid-template-columns: 60px 1fr; gap: 0.85rem; } .ep__art { width: 60px; height: 60px; } }
</style>
