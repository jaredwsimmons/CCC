---
// The words and buttons come from Site Settings → Other wording.
import Base from '../layouts/Base.astro';
import Buttons from '../components/Buttons.astro';
import { withBase } from '../data/site';
import { sanityFetch } from '../lib/sanity';
import { settingsQuery } from '../lib/queries';

const settings = await sanityFetch<any>(settingsQuery, {}, Astro.cookies);
const notFound = settings?.notFound;
---
<Base title={notFound?.heading} description={notFound?.text}>
  <section class="nf">
    <div class="wrap inner">
      <img src={withBase('/images/icon-gold.png')} alt="" width="72" height="72" />
      <p class="eyebrow on-dark">404</p>
      {notFound?.heading && <h1>{notFound.heading}</h1>}
      {notFound?.text && <p class="lead">{notFound.text}</p>}
      <div class="actions"><Buttons list={notFound?.buttons} large bare dark /></div>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--navy);
    color: var(--cream);
    min-height: 60vh;
    display: grid;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .inner { max-width: 640px; }
  .inner img { width: 64px; height: 64px; margin-bottom: 1.25rem; }
  .nf h1 { color: #fff; }
  .nf .lead { color: rgba(251, 249, 244, 0.82); margin-top: 0.9rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.6rem; }
</style>
