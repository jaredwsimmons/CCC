---
// Page hero. With an image: the navy "feature" hero, title on the left and the photo framed
// on the right. Without: the light "quiet" hero for ministry and long-reading pages, with
// an optional aside (the deacon card) on the right. Both carry the pill label.
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: string;
  imageAlt?: string;
}
const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---
{image ? (
  <section class="hero phero--feature">
    <div class="wrap inner">
      <div class="phero__main">
        {eyebrow && <p class="chip">{eyebrow}</p>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <div class="actions"><slot /></div>
      </div>
      <div class="phero__photo">
        <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>
) : (
  <section class="phero--paper">
    <div class="wrap inner">
      <div class="phero__main">
        {eyebrow && <p class="chip">{eyebrow}</p>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <div class="actions"><slot /></div>
      </div>
      <div class="phero__aside"><slot name="aside" /></div>
    </div>
  </section>
)}

<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.04; letter-spacing: -0.03em; }
  .chip { margin-bottom: 1rem; }
  .lead { margin-top: 1rem; }

  .phero--feature .inner {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem 4rem;
  }
  .phero--feature .phero__main { flex: 1 1 420px; min-width: 0; }
  .phero--feature h1 { max-width: 14ch; }
  .phero--feature .lead { color: rgba(251, 249, 244, 0.9); max-width: 34em; }
  .phero__photo { flex: 1 1 380px; min-width: 0; }
  .phero__photo img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--r); }

  .phero--paper {
    background: #fff;
    border-bottom: 1px solid var(--hair);
  }
  .phero--paper .inner {
    padding-block: clamp(2.75rem, 7vw, 4.5rem);
    display: flex;
    align-items: center;
    gap: 1.5rem 2.5rem;
    flex-wrap: wrap;
  }
  .phero__main { flex: 1 1 460px; min-width: 0; }
  /* aside grows to fill the right column and centers the badge within it */
  .phero__aside { flex: 1 1 300px; display: flex; justify-content: center; }
  .phero__aside:empty { display: none; }
  /* on narrow screens the badge drops below the title, full-ish width */
  @media (max-width: 680px) { .phero__aside { flex-basis: 100%; } }

  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.6rem; }
  .actions:empty { display: none; }
</style>
