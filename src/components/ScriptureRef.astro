---
// A single scripture reference with a hover/focus tooltip of the ESV text (the same
// markup as scriptureRefHtml() in src/lib/esv.ts, which rich text uses). The verse loads
// from /api/esv on first hover, focus or tap; ScriptureTooltips.astro (in the layout)
// holds the styles and that script. Without an ESV key the reference is plain text.
import { hasEsvKey } from '../lib/esv';

interface Props {
  reference: string;
}
const { reference } = Astro.props;
---
{hasEsvKey() ? (
  <span class="sref" tabindex="0" data-ref={reference}>
    <span class="sref-label">{reference}</span>
    <span class="sref-pop" role="tooltip">
      <span class="sref-text">Loading…</span>
      <cite class="sref-cite">ESV</cite>
    </span>
  </span>
) : (
  <span class="sref-plain">{reference}</span>
)}
