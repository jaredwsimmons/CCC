---
// A single scripture reference with a hover/focus tooltip of the ESV text.
// The verse loads from /api/esv the first time the reference is hovered, focused or
// tapped (src/lib/esv.ts explains why not while rendering). If no ESV key is
// configured, the reference renders as plain text (no tooltip) — the page is fully
// functional either way.
import { hasEsvKey } from '../lib/esv';

interface Props {
  reference: string;
}
const { reference } = Astro.props;
---
{hasEsvKey() ? (
  <span class="sref" tabindex="0" data-ref={reference}>
    <span class="sref-label">{reference}</span>
    <span class="sref-pop" role="tooltip">
      <span class="sref-text">Loading…</span>
      <cite class="sref-cite">ESV</cite>
    </span>
  </span>
) : (
  <span class="sref-plain">{reference}</span>
)}

<script>
  // Load each reference's verse once, on its first hover, focus or tap.
  async function load(el: HTMLElement) {
    if (el.dataset.loaded) return;
    el.dataset.loaded = '1';
    const out = el.querySelector('.sref-text');
    try {
      const res = await fetch(`/api/esv?ref=${encodeURIComponent(el.dataset.ref ?? '')}`);
      if (!res.ok) throw new Error(`ESV ${res.status}`);
      const { text } = (await res.json()) as { text: string };
      if (out) out.textContent = text;
    } catch {
      if (out) out.textContent = 'The verse text could not be loaded.';
    }
  }
  for (const type of ['pointerenter', 'focusin']) {
    document.addEventListener(
      type,
      (e) => {
        const el = (e.target as Element | null)?.closest?.('.sref[data-ref]');
        if (el instanceof HTMLElement) load(el);
      },
      true,
    );
  }
</script>

<style>
  .sref {
    position: relative;
    display: inline;
  }
  .sref-label {
    border-bottom: 1px dotted currentColor;
    cursor: help;
  }
  .sref:hover .sref-label,
  .sref:focus-visible .sref-label {
    color: var(--blue-deep);
  }

  .sref-pop {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 40;
    width: max-content;
    max-width: min(340px, 78vw);
    background: #fff;
    color: var(--navy);
    border: 1px solid var(--hair);
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 0.7rem 0.85rem;
    /* reset the small-caps caption styling inherited from .scripture */
    font-family: var(--body);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
    text-align: left;
    white-space: normal;
  }
  .sref:hover .sref-pop,
  .sref:focus .sref-pop,
  .sref:focus-within .sref-pop {
    display: block;
  }

  .sref-cite {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mid);
    font-style: normal;
  }
</style>
