---
// Small on-brand card naming the deacon(s) who serve a ministry (the page header's
// "Deacon card" in Sanity).
import { withBase } from '../data/site';
interface Props { deacons?: string[] | null; blurb?: string; }
const { deacons, blurb } = Astro.props;
---
{deacons && deacons.length > 0 && (
  <div class="deacon" data-reveal>
    <div class="deacon__mark" aria-hidden="true">
      <img src={withBase('/images/icon-gold.png')} alt="" width="30" height="30" />
    </div>
    <div>
      <p class="deacon__label">{deacons.length > 1 ? 'Deacons' : 'Deacon'}</p>
      <p class="deacon__names">{deacons.join(', ')}</p>
      {blurb && <p class="deacon__blurb">{blurb}</p>}
    </div>
  </div>
)}

<style>
  .deacon {
    display: flex;
    gap: 1.1rem;
    align-items: center;
    background: #fff;
    border: 1px solid var(--hair);
    border-left: 4px solid var(--gold);
    border-radius: var(--r);
    padding: 0.85rem 1.1rem;
    box-shadow: var(--shadow);
    width: clamp(240px, 100%, 300px);
  }
  .deacon__mark {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--navy);
    display: grid;
    place-items: center;
  }
  .deacon__label {
    font-family: var(--display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .deacon__names { font-family: var(--display); font-weight: 600; color: var(--navy); font-size: 1.1rem; margin-top: 0.05rem; }
  .deacon__blurb { font-size: 0.9rem; color: var(--mid); margin-top: 0.2rem; }
</style>
