---
// Upcoming events from Church Center, live, with List and Month views.
import Section from '../Section.astro';
import EventList from '../EventList.astro';
import RichText from '../RichText.astro';
import { inModal, variantFor } from '../../lib/links';
import { getUpcomingEventsResult, buildMonthGrids, onePerSeries, fullDate } from '../../lib/calendar';
import { site } from '../../data/site';
const { s } = Astro.props;
const result = await getUpcomingEventsResult();
const events = result ?? [];
const monthGrids = buildMonthGrids(events);
const DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
---
<Section variant={variantFor(s.background)}>
  <div data-calendar-section>
    <div class="ev-head" data-reveal>
      <div>
        {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
        {s.heading && <h2>{s.heading}</h2>}
      </div>
      <div class="viewtoggle" role="group" aria-label="Calendar view">
        <button type="button" data-view-btn="list" class="is-active" aria-pressed="true">List</button>
        <button type="button" data-view-btn="month" aria-pressed="false">Month</button>
      </div>
    </div>


    {result === null ? <p class="note" role="status">{s.unavailableMessage || 'We could not load the calendar right now.'} <a href={site.churchCenter.calendarPage} target="_blank" rel="noopener noreferrer">Open the Church Center calendar</a></p>
      : events.length === 0 && <div class="note" data-reveal><RichText value={s.emptyText} /></div>}

    <!-- LIST view -->
    <div data-view="list">
      <EventList events={onePerSeries(events)} />
    </div>

    <!-- MONTH view -->
    <div data-view="month" hidden>
      {monthGrids.map((mg) => (
        <div class="month" data-reveal>
          <h3 class="month__label">{mg.label}</h3>
          <div class="cal-scroll" tabindex="0" role="region" aria-label={`${mg.label} calendar, scroll horizontally for more days`}>
            <div class="cal-grid">
              {DOW.map((d) => <div class="cal-dow">{d}</div>)}
              {mg.weeks.flat().map((cell) => cell ? (
                <div class={`cal-cell${cell.events.length ? ' has-ev' : ''}`}>
                  <span class="cal-day">{cell.day}</span>
                  {cell.events.slice(0, 3).map((e) => {
                    const href = e.register ? inModal(e.register) : e.publicUrl;
                    return href
                      ? <a class="cal-ev" href={href} target={e.register ? undefined : '_blank'} rel="noopener noreferrer" title={e.title} aria-label={`${e.title}, ${fullDate(e.date)}, ${e.timeLabel}`}>{e.title}</a>
                      : <span class="cal-ev" title={e.title}>{e.title}</span>;
                  })}
                  {cell.events.length > 3 && <details class="cal-extra">
                    <summary class="cal-more" aria-label={`${cell.events.length - 3} more events on ${fullDate(cell.date)}`}>+{cell.events.length - 3} more</summary>
                    {cell.events.slice(3).map((e) => {
                      const href = e.register ? inModal(e.register) : e.publicUrl;
                      return href ? <a class="cal-ev" href={href} target={e.register ? undefined : '_blank'} rel="noopener noreferrer" aria-label={`${e.title}, ${fullDate(e.date)}, ${e.timeLabel}`}>{e.title}</a> : <span class="cal-ev">{e.title}</span>;
                    })}
                  </details>}
                </div>
              ) : <div class="cal-cell cal-cell--empty"></div>)}
            </div>
          </div>
        </div>
      ))}
    </div>

    {s.note?.length > 0 && <div class="note" data-reveal><RichText value={s.note} /></div>}
  </div>
</Section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-calendar-section]').forEach(function (root) {
    if (root.dataset.initialized) return;
    root.dataset.initialized = 'true';
    var btns = root.querySelectorAll('[data-view-btn]');
    var views = root.querySelectorAll('[data-view]');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var v = btn.getAttribute('data-view-btn');
        btns.forEach(function (b) { b.classList.toggle('is-active', b === btn); b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        views.forEach(function (x) { x.hidden = x.getAttribute('data-view') !== v; });
      });
    });
    });
  })();
</script>

<style>
  /* view toggle */
  .ev-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .viewtoggle { display: inline-flex; background: #fff; border: 1px solid var(--hair); border-radius: 999px; padding: 0.2rem; box-shadow: var(--shadow); }
  .viewtoggle button {
    font-family: var(--display); font-weight: 600; font-size: 0.9rem; color: var(--mid);
    background: none; border: 0; padding: 0.45rem 1.1rem; border-radius: 999px; cursor: pointer;
  }
  .viewtoggle button.is-active { background: var(--navy); color: var(--cream); }

  .month + .month { margin-top: 2rem; }
  .month__label { font-size: 1.1rem; color: var(--navy); margin-bottom: 0.9rem; }

  /* month grid view */
  .cal-scroll { overflow-x: auto; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, minmax(96px, 1fr)); gap: 1px; background: var(--hair); border: 1px solid var(--hair); border-radius: var(--r); overflow: hidden; }
  .cal-dow { background: var(--navy); color: var(--cream); font-family: var(--display); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; text-align: center; padding: 0.5rem 0; }
  .cal-cell { background: #fff; min-height: 92px; padding: 0.35rem 0.4rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .cal-cell--empty { background: var(--paper); }
  .cal-day { font-family: var(--display); font-weight: 600; font-size: 0.8rem; color: var(--mid); }
  .has-ev .cal-day { color: var(--navy); }
  .cal-ev {
    font-size: 0.7rem; line-height: 1.2; color: var(--navy); background: rgba(0,82,145,0.08);
    border-left: 2px solid var(--blue); padding: 0.12rem 0.3rem; border-radius: 3px;
    text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  a.cal-ev:hover { background: rgba(0,82,145,0.15); }
  .cal-more { font-size: 0.66rem; color: var(--mid); font-weight: 600; }
  summary.cal-more { cursor: pointer; }
  .cal-extra .cal-ev { display: block; margin-top: 0.2rem; }

  .note { margin-top: 1.75rem; font-size: 0.95rem; color: var(--mid); }
</style>
