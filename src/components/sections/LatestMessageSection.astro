---
// The newest sermon from the podcast or YouTube, live.
import LatestMessage, { type Message } from '../LatestMessage.astro';
import { getPodcastEpisodes, getYouTubeVideos } from '../../lib/feeds';
import { imageUrl } from '../../lib/image';
import { sanityFetch } from '../../lib/sanity';
import { seriesArtQuery } from '../../lib/queries';
const { s } = Astro.props;
const artwork = await sanityFetch<any>(seriesArtQuery, {}, Astro.cookies);
let message: Message | undefined;
if (s.source === 'video') {
  const v = (await getYouTubeVideos())[0];
  if (v) message = { title: v.title, date: v.date, image: v.thumbnail, videoUrl: v.url };
} else {
  message = (await getPodcastEpisodes())[0];
}
---
{message && <LatestMessage message={message} eyebrow={s.eyebrow} watchLabel={s.watchLabel} watchUrl={s.watchUrl} listenLabel={s.listenLabel} fallbackImage={imageUrl(artwork, 900)} />}
