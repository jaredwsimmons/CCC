---
// The current announcements from Church Center, live (the Announcements page).
import Section from '../Section.astro';
import AnnouncementList from '../AnnouncementList.astro';
import RichText from '../RichText.astro';
import { getAnnouncementsResult } from '../../lib/announcements';
import { site } from '../../data/site';
const { s } = Astro.props;
const result = await getAnnouncementsResult();
const items = result ?? [];
---
{(result === null || items.length > 0 || s.emptyText?.length > 0) && (
  <Section eyebrow={s.eyebrow} title={s.heading} class="live-data">
    {result === null ? <p role="status">{s.unavailableMessage || 'We could not load announcements right now.'} <a href={`https://${site.churchCenter.subdomain}/announcements`} target="_blank" rel="noopener noreferrer">See announcements on Church Center</a></p>
      : items.length > 0 ? <AnnouncementList items={items} layout="list" /> : <div data-reveal><RichText value={s.emptyText} /></div>}
  </Section>
)}
