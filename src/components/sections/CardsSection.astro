---
// Short items side by side. A card's small label can hold Bible references (tooltips).
import Section from '../Section.astro';
import Scripturize from '../Scripturize.astro';
import DeaconNote from '../DeaconNote.astro';
import { imageUrl, type SanityImage } from '../../lib/image';
import { buttonLink, variantFor, type Button } from '../../lib/links';
const { s } = Astro.props;
type Card = { _key: string; label?: string; title?: string; text?: string; bullets?: string[]; buttons?: Button[] | null; ministry?: { deacons?: string[] } | null; logo?: SanityImage; logoOnDark?: boolean };
const cards = ((s.cards ?? []) as Card[]).map((c) => ({
  ...c,
  logoSrc: imageUrl(c.logo, 600),
  links: (c.buttons ?? []).flatMap((b) => {
    const link = buttonLink(b);
    return link && b.label ? [{ label: b.label, ...link }] : [];
  }),
}));
---
<Section variant={variantFor(s.background)} eyebrow={s.eyebrow} title={s.heading} lead={s.intro} center={Boolean(s.heading)}>
  <div class={`grid cols-${s.columns ?? 3}`}>
    {cards.map((c) => (
      <div class:list={['card', { 'card--logo': c.logoSrc }]} data-reveal>
        {c.logoSrc && (
          <div class:list={['logo', { 'logo--dark': c.logoOnDark }]}>
            <img src={c.logoSrc} alt={c.logo?.alt ?? ''} loading="lazy" />
          </div>
        )}
        <div class="card__body">
        {c.label && <span class="scripture"><Scripturize text={c.label} /></span>}
        <h3>{c.title}</h3>
        {c.text && <p>{c.text}</p>}
        {c.bullets && c.bullets.length > 0 && <ul class="list">{c.bullets.map((b) => <li>{b}</li>)}</ul>}
        {c.links.length > 0 && (
          <p class="links">
            {c.links.map((l) => (
              <a href={l.href} target={l.newTab ? '_blank' : undefined} rel={l.newTab ? 'noopener noreferrer' : undefined}>{l.label}</a>
            ))}
          </p>
        )}
        {c.ministry?.deacons?.length ? <div class="deacon-slot"><DeaconNote deacons={c.ministry.deacons} /></div> : null}
        </div>
      </div>
    ))}
  </div>
</Section>

<style>
  .list { list-style: none; display: grid; gap: 0.55rem; margin-top: 0.5rem; }
  .list li { padding-left: 1.1rem; position: relative; font-size: 0.98rem; color: var(--mid); }
  .list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
  }
  .card { text-align: left; display: flex; flex-direction: column; }
  .card__body { display: flex; flex-direction: column; flex: 1; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.6rem; font-size: 0.92rem; }

  /* A card with a logo: the logo centered in a full-width band of the same height on every
     card, the words centered below, and the links at the foot so a row lines up. */
  .card--logo { padding: 0; overflow: hidden; text-align: center; }
  .logo { height: 120px; display: flex; align-items: center; justify-content: center; padding: 20px 28px; border-bottom: 1px solid var(--hair); box-sizing: border-box; }
  .logo img { max-height: 100%; max-width: 100%; object-fit: contain; }
  /* logos saved with a white background (JPGs) blend into the white band instead of showing a box */
  .logo:not(.logo--dark) img { mix-blend-mode: multiply; }
  /* a white logo gets a navy band */
  .logo--dark { background: var(--navy); border-bottom-color: var(--navy); }
  .card--logo .card__body { padding: 1.25rem 1.4rem 1.4rem; }
  .card--logo .links { justify-content: center; margin-top: auto; padding-top: 0.9rem; }

  /* a card with a deacon badge keeps the badge at its foot, level across the row */
  .deacon-slot { margin-top: auto; padding-top: 1.1rem; }
  .deacon-slot :global(.deacon) { width: 100%; }
</style>
