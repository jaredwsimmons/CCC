---
// A YouTube playlist, live (src/lib/feeds.ts): the newest video plays here — its thumbnail
// until someone presses play, so YouTube's player only loads when wanted — and the next few
// link to YouTube. Without JavaScript the play button is a plain link to YouTube.
import Section from '../Section.astro';
import Buttons from '../Buttons.astro';
import { getPlaylistVideos } from '../../lib/feeds';
import { variantFor } from '../../lib/links';
const { s } = Astro.props;
const videos = await getPlaylistVideos(s.playlist);
const [newest, ...rest] = videos;
const earlier = rest.slice(0, s.count ?? 3);
const fmtDate = (d: Date | null) => (d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '');
---
{newest && (
  <Section variant={variantFor(s.background)} eyebrow={s.eyebrow} title={s.heading} id="videos" class="live-data">
    <div class="player" data-reveal>
      <a class="player__poster" href={newest.url} target="_blank" rel="noopener noreferrer" data-video-id={newest.id}>
        <img src={`https://i.ytimg.com/vi/${newest.id}/sddefault.jpg`} alt="" />
        <span class="player__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
        <span class="sr-only">Play {newest.title}</span>
      </a>
      <p class="player__title">{newest.title}</p>
    </div>
    {earlier.length > 0 && (
      <ul class="earlier" data-reveal>
        {earlier.map((v) => (
          <li>
            <a href={v.url} target="_blank" rel="noopener noreferrer">
              <img src={v.thumbnail} alt="" loading="lazy" />
              <span class="earlier__title">{v.title}</span>
              <span class="earlier__date">{fmtDate(v.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="mt-2" data-reveal><Buttons list={s.buttons} solid={0} /></div>
  </Section>
)}

<script is:inline>
  // Swap the poster for YouTube's player (privacy-enhanced embed) when someone presses play.
  document.addEventListener('click', function (e) {
    var poster = e.target.closest && e.target.closest('[data-video-id]');
    if (!poster || e.ctrlKey || e.metaKey || e.shiftKey) return;
    e.preventDefault();
    var frame = document.createElement('iframe');
    frame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(poster.getAttribute('data-video-id')) + '?autoplay=1&rel=0';
    frame.title = poster.querySelector('.sr-only').textContent;
    frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    frame.allowFullscreen = true;
    frame.className = 'player__frame';
    poster.replaceWith(frame);
  });
</script>

<style>
  .player { max-width: 860px; }
  .player__poster, :global(.player__frame) { display: block; position: relative; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: var(--r); overflow: hidden; background: var(--navy-deep); }
  .player__poster img { width: 100%; height: 100%; object-fit: cover; }
  .player__play {
    position: absolute; inset: 0; margin: auto; width: 72px; height: 72px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(0, 82, 145, 0.92); color: #fff; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease;
  }
  .player__poster:hover .player__play { transform: scale(1.06); }
  .player__title { margin-top: 0.8rem; font-family: var(--display); font-weight: 600; font-size: 1.1rem; color: var(--navy); }
  .earlier { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 1.25rem; margin-top: 2rem; }
  .earlier a { display: block; text-decoration: none; }
  .earlier img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; }
  .earlier__title { display: block; margin-top: 0.6rem; font-family: var(--display); font-weight: 600; font-size: 0.95rem; color: var(--navy); }
  .earlier a:hover .earlier__title { color: var(--blue); }
  .earlier__date { display: block; font-size: 0.85rem; color: var(--mid); }
</style>
