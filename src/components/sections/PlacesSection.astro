---
// "Find your place": ministry tiles (a photo, or words on a plain or pale-blue tile), the
// first one wider, then small buttons for the ministries without a tile.
import Section from '../Section.astro';
import { imagePosition, imageUrl, type SanityImage } from '../../lib/image';
import { buttonLink, type Button } from '../../lib/links';
const { s } = Astro.props;

const ext = { target: '_blank', rel: 'noopener noreferrer' };
/** A Sanity button as link attributes, or null if it isn't filled in. */
const linkFor = (b?: Button | null) => {
  const link = buttonLink(b);
  return link && b?.label ? { label: b.label, attrs: { href: link.href, ...(link.newTab ? ext : {}) } } : null;
};
type Tile = { _key: string; link?: Button; text?: string; image?: SanityImage; cta?: string; highlight?: boolean };
const tiles = ((s.tiles ?? []) as Tile[])
  .map((t) => ({ ...t, to: linkFor(t.link), src: imageUrl(t.image, 900), alt: t.image?.alt ?? '', style: imagePosition(t.image) }))
  .filter((t) => t.to);
const moreLinks = ((s.moreLinks ?? []) as Button[]).map(linkFor).filter((l) => l !== null);
---
{tiles.length > 0 && (
  <Section eyebrow={s.eyebrow} title={s.heading} id="place">
    <ul class="places">
      {tiles.map((t) => (
        <li data-reveal>
          <a class:list={['tile', { 'tile--photo': t.src, 'tile--tint': !t.src && t.highlight }]} {...t.to!.attrs}>
            {t.src && <img src={t.src} alt={t.alt} style={t.style} loading="lazy" />}
            <span class="tile__body">
              <span class="tile__title">{t.to!.label}</span>
              {t.text && <span class="tile__text">{t.text}</span>}
              {t.cta && <span class="tile__cta">{t.cta} <span aria-hidden="true">→</span></span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
    {moreLinks.length > 0 && (
      <div class="more" data-reveal>
        {s.moreLabel && <p>{s.moreLabel}</p>}
        <ul>{moreLinks.map((l) => <li><a {...l!.attrs}>{l!.label}</a></li>)}</ul>
      </div>
    )}
  </Section>
)}

<style>
  .places { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .places > li:first-child { grid-column: span 2; }
  @media (max-width: 900px) { .places { grid-template-columns: repeat(2, minmax(0, 1fr)); } .places > li:first-child { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .places { grid-template-columns: 1fr; } }
  .tile {
    height: 100%; box-sizing: border-box; display: flex; flex-direction: column; background: #fff; border-radius: 24px;
    overflow: hidden; text-decoration: none; color: var(--navy); transition: transform 0.16s ease;
  }
  .tile:hover { color: var(--navy); transform: translateY(-2px); }
  .tile img { width: 100%; height: clamp(170px, 18vw, 240px); object-fit: cover; }
  .tile--tint { background: var(--tint); }
  .tile__body { display: flex; flex-direction: column; flex: 1; padding: 1.4rem 1.6rem 1.6rem; }
  .tile:not(.tile--photo) .tile__body { padding-top: 1.75rem; min-height: 13rem; box-sizing: border-box; }
  .tile__title { font-family: var(--display); font-weight: 600; font-size: 1.55rem; letter-spacing: -0.015em; line-height: 1.15; }
  .tile__text { margin-top: 0.4rem; color: var(--mid); }
  .tile--tint .tile__text { color: #3d4f5e; }
  .tile__cta { margin-top: auto; padding-top: 1.1rem; font-family: var(--display); font-weight: 600; color: var(--blue); }
  .more { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.6rem 1rem; margin-top: 1.5rem; text-align: center; }
  .more p { font-family: var(--display); font-weight: 600; font-size: 0.95rem; color: var(--mid); }
  .more ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .more a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1.2rem; border-radius: 999px;
    background: #fff; border: 1px solid var(--hair); font-family: var(--display); font-weight: 600; font-size: 0.95rem; text-decoration: none;
  }
  .more a:hover { border-color: var(--blue); }
</style>
