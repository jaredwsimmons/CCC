---
// One Church Center registration, live; nothing shows once registration closes.
import Section from '../Section.astro';
import RegistrationCard from '../RegistrationCard.astro';
import { getRegistrationByUrl } from '../../lib/registrations';
const { s, settings } = Astro.props;
const reg = await getRegistrationByUrl(s.url, settings?.integrations?.churchCenterHost);
---
{reg && (
  <Section tight>
    <div class="one"><RegistrationCard reg={reg} settings={settings} /></div>
  </Section>
)}

<style>
  .one { max-width: 34rem; }
</style>
