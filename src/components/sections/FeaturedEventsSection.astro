---
// Upcoming events marked "featured" in Planning Center Calendar, live.
import Section from '../Section.astro';
import EventList from '../EventList.astro';
import { getUpcomingEvents, onePerSeries } from '../../lib/calendar';
const { s, settings } = Astro.props;
const events = onePerSeries(await getUpcomingEvents(settings?.integrations?.churchCenterHost)).filter((e) => e.featured);
---
{events.length > 0 && (
  <Section variant="alt" eyebrow={s.eyebrow} title={s.heading}>
    <EventList events={events} settings={settings} />
  </Section>
)}
