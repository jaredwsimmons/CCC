---
// A numbered how-to, or a dated timeline.
import Section from '../Section.astro';
import Buttons from '../Buttons.astro';
import { variantFor } from '../../lib/links';
const { s } = Astro.props;
type Step = { _key: string; title?: string; text?: string };
const steps = (s.steps ?? []) as Step[];
const variant = variantFor(s.background);
---
<Section variant={variant} eyebrow={s.eyebrow} title={s.heading}>
  <ol class:list={['steps', s.timeline && 'steps--timeline']} data-reveal>
    {steps.map((st) => (
      <li>
        <div>
          {st.title && <h3>{st.title}</h3>}
          <p>{st.text}</p>
        </div>
      </li>
    ))}
  </ol>
  {s.closing && <p class="measure closing" data-reveal>{s.closing}</p>}
  <Buttons list={s.buttons} dark={variant === 'navy'} solid={0} />
</Section>

<style>
  .steps {
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 0.9rem;
    max-width: 62ch;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding-left: 3rem;
    min-height: 2.2rem;
    display: flex;
    align-items: center;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--navy);
    font-family: var(--display);
    font-weight: 600;
    display: grid;
    place-items: center;
  }
  .steps h3 { font-size: 1.05rem; margin-bottom: 0.2rem; }
  .steps--timeline { gap: 0; }
  .steps--timeline li { padding: 0 0 1.25rem 2rem; min-height: 0; }
  .steps--timeline li:last-child { padding-bottom: 0; }
  .steps--timeline li::before { content: ""; top: 0.3rem; width: 0.8rem; height: 0.8rem; }
  .steps--timeline li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(0.4rem - 1px);
    top: 1.1rem;
    bottom: -0.3rem;
    width: 2px;
    background: var(--gold);
  }
  .closing { margin-top: 2rem; font-style: italic; color: var(--mid); }
</style>
