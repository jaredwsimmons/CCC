---
// The newest sermon (the Media page and the Latest message section): podcast episode
// with an audio player, or a YouTube video.
import Section from './Section.astro';
import Scripturize from './Scripturize.astro';
import { fmtDuration } from '../lib/feeds';

export type Message = {
  title: string;
  subtitle?: string;
  date: Date | null;
  duration?: string;
  audioUrl?: string;
  image?: string;
  link?: string;
  videoUrl?: string;
};
interface Props { message: Message; eyebrow?: string; watchLabel?: string; watchUrl?: string; browseLabel?: string; listenLabel?: string; fallbackImage?: string | null; }
const { message: m, eyebrow, watchLabel, watchUrl, browseLabel = 'Browse videos', listenLabel, fallbackImage } = Astro.props;
const watch = m.videoUrl ?? watchUrl;
const videoLabel = m.videoUrl ? watchLabel : browseLabel;
const fmtDate = (d: Date | null) => (d ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '');
const art = m.image || fallbackImage;
---
<Section variant="navy" tight>
  <div class="latest" data-reveal>
    {art && (
      <div class="latest__art">
        <img src={art} alt={m.title} loading="eager" />
      </div>
    )}
    <div class="latest__body">
      {eyebrow && <p class="eyebrow on-dark">{eyebrow}</p>}
      <h2>{m.title}</h2>
      {m.subtitle && <p class="latest__sub"><Scripturize text={m.subtitle} /></p>}
      <p class="latest__meta">{fmtDate(m.date)}{m.duration && ` · ${fmtDuration(m.duration)}`}</p>
      {m.audioUrl && <audio class="latest__audio" controls preload="none" src={m.audioUrl}></audio>}
      <div class="latest__cta">
        {watch && videoLabel && <a class="btn btn--gold" href={watch} target="_blank" rel="noopener noreferrer">{videoLabel}</a>}
        {m.link && listenLabel && <a class="btn btn--outline-light" href={m.link} target="_blank" rel="noopener noreferrer">{listenLabel}</a>}
      </div>
    </div>
  </div>
</Section>

<style>
  .latest { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .latest__art { border-radius: 16px; overflow: hidden; aspect-ratio: 16/9; }
  .latest__art img { width: 100%; height: 100%; object-fit: cover; }
  .latest__sub { margin-top: 0.6rem; color: rgba(251,249,244,0.9); font-weight: 600; }
  .latest__meta { margin-top: 0.3rem; color: rgba(251,249,244,0.6); font-size: 0.9rem; }
  .latest__audio { margin-top: 1rem; width: 100%; max-width: 460px; height: 40px; }
  .latest__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.2rem; }
  @media (max-width: 800px) { .latest { grid-template-columns: 1fr; } }
</style>
