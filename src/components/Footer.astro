---
// Church details come from Site Settings in Sanity (passed in by Base.astro); an item
// whose field is empty is left out rather than linking nowhere.
import { site, withBase } from '../data/site';
import { hasEsvKey } from '../lib/esv';
import { shortTimes, telHref } from '../lib/format';
import { buttonLink, type Button } from '../lib/links';
interface Props { settings: any; } // Site Settings, from Base.astro
const { settings } = Astro.props;
const year = new Date().getFullYear();
const give = `${site.churchCenter.giving}?open-in-church-center-modal=true`;
const a = settings?.address;
const address = a ? [a.line1, a.city && `${a.city}, ${[a.state, a.zip].filter(Boolean).join(' ')}`].filter(Boolean).join(', ') : '';
const social = settings?.social ?? {};
const times = shortTimes(settings?.serviceTimes);
const ext = { target: '_blank', rel: 'noopener noreferrer' };
// The prayer, media and app links are buttons in Site Settings, so they follow the same
// link rules as every other button; an unfinished one is left out.
const footerLink = (b?: Button | null) => {
  const link = buttonLink(b);
  return link && b?.label ? { label: b.label, attrs: { href: link.href, ...(link.newTab ? ext : {}) } } : null;
};
const prayer = footerLink(settings?.footerPrayer);
const media = footerLink(settings?.footerMedia);
const app = footerLink(settings?.footerApp);
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="id">
      <img src={withBase('/images/icon-white.png')} alt="" width="64" height="64" loading="lazy" />
      <p class="name">Chelsea Community<br />Church</p>
      <p class="tagline">Pursuing God. <b>Pursuing others.</b></p>
      {times && <p class="times">Sundays · {times}</p>}
    </div>

    <div class="col" aria-labelledby="ftr-touch">
      <h2 id="ftr-touch">Get in Touch</h2>
      <ul>
        {address && (
          <li>
            <span class="label">Address</span>
            {a.mapsUrl ? <a href={a.mapsUrl} {...ext}>{address}</a> : address}
          </li>
        )}
        {settings?.phone && (
          <li>
            <span class="label">Phone</span>
            <a href={telHref(settings.phone)}>{settings.phone}</a>
          </li>
        )}
        {settings?.email && (
          <li>
            <span class="label">Email us</span>
            <a href={`mailto:${settings.email}`}>Get in touch with us, we're here to listen!</a>
          </li>
        )}
        {prayer && (
          <li>
            <span class="label">Prayer</span>
            <a {...prayer.attrs}>{prayer.label}</a>
          </li>
        )}
      </ul>
    </div>

    <div class="col" aria-labelledby="ftr-connect">
      <h2 id="ftr-connect">Connect</h2>
      <ul>
        {social.facebook && <li><a href={social.facebook} {...ext}>Facebook</a></li>}
        {social.instagram && <li><a href={social.instagram} {...ext}>Instagram</a></li>}
        {social.youtube && <li><a href={social.youtube} {...ext}>YouTube</a></li>}
        {media && <li><a {...media.attrs}>{media.label}</a></li>}
        {social.textSignup && <li><a href={social.textSignup} {...ext} data-small-window>Text updates</a></li>}
        {app && <li><a {...app.attrs}>{app.label}</a></li>}
      </ul>
    </div>

    <div class="col" aria-labelledby="ftr-explore">
      <h2 id="ftr-explore">Explore</h2>
      <ul class="two-col">
        <li><a href={withBase('/imnew')}>I'm New</a></li>
        <li><a href={withBase('/about')}>About</a></li>
        <li><a href={withBase('/leaders')}>Leaders</a></li>
        <li><a href={withBase('/calendar')}>Calendar</a></li>
        <li><a href={withBase('/groups')}>Community Groups</a></li>
        <li><a href={withBase('/serve')}>Ministries</a></li>
        <li><a href={withBase('/media')}>Media</a></li>
        <li><a href={withBase('/bylaws')}>Bylaws</a></li>
        <li><a href={give}>Give</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap bottom">
    <p>Copyright © {year}. All rights reserved. Chelsea Community Church</p>
    {hasEsvKey() && (
      <p class="esv">Scripture quotations are from the ESV® Bible (The Holy Bible, English Standard Version®), copyright © 2001 by Crossway, a publishing ministry of Good News Publishers. Used by permission. All rights reserved.</p>
    )}
  </div>
</footer>

<!-- TxtSignal refuses to load inside another site, so it can't use a pop-up like Church
     Center's. A small window of its own is the closest; phones keep the new tab. -->
<script is:inline>
  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('a[data-small-window]');
    if (!link || e.ctrlKey || e.metaKey || e.shiftKey || window.matchMedia('(max-width: 700px)').matches) return;
    var left = Math.round(window.screenX + (window.outerWidth - 480) / 2);
    var top = Math.round(window.screenY + 60);
    var win = window.open(link.href, 'text-signup', 'popup,width=480,height=720,left=' + left + ',top=' + top);
    if (win) {
      win.opener = null;
      e.preventDefault();
    }
  });
</script>

<style>
  .top {
    display: grid;
    grid-template-columns: 1.1fr 1.2fr 0.8fr 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-block: clamp(2.5rem, 6vw, 3.75rem) 2rem;
  }
  @media (max-width: 960px) { .top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .top { grid-template-columns: 1fr; } }

  .id img { width: 56px; height: 56px; margin-bottom: 0.9rem; }
  .name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.25;
    color: #fff;
  }
  .tagline { margin-top: 0.5rem; font-size: 0.95rem; color: rgba(251, 249, 244, 0.8); }
  .tagline b { color: var(--gold); font-weight: 600; }
  .times { margin-top: 0.35rem; font-size: 0.9rem; color: rgba(251, 249, 244, 0.65); }

  h2 {
    font-family: var(--display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.9rem;
  }
  .col ul { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; }
  .col a { text-decoration: none; font-size: 0.95rem; }
  .col a:hover { text-decoration: underline; }
  .label {
    display: block;
    font-family: var(--display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(251, 249, 244, 0.55);
  }
  .two-col { display: grid !important; grid-template-columns: 1fr 1fr; gap: 0.45rem 1rem; }

  .bottom {
    border-top: 1px solid rgba(251, 249, 244, 0.15);
    padding-block: 1.1rem;
    margin-top: auto; /* pin copyright to the bottom edge when the footer stretches */
  }
  .bottom p { font-size: 0.85rem; color: rgba(251, 249, 244, 0.6); }
  .bottom .esv { margin-top: 0.4rem; font-size: 0.75rem; }
</style>
