---
// Styles and loader for every scripture tooltip on the page (ScriptureRef.astro and
// references inside rich text). Included once by the layout when an ESV key is set.
---
<script>
  // Load each reference's verse once, on its first hover, focus or tap.
  async function load(el: HTMLElement) {
    if (el.dataset.loaded) return;
    el.dataset.loaded = '1';
    const out = el.querySelector('.sref-text');
    try {
      const res = await fetch(`/api/esv?ref=${encodeURIComponent(el.dataset.ref ?? '')}`);
      if (!res.ok) throw new Error(`ESV ${res.status}`);
      const { text } = (await res.json()) as { text: string };
      if (out) out.textContent = text;
    } catch {
      if (out) out.textContent = 'The verse text could not be loaded.';
    }
  }
  for (const type of ['pointerenter', 'focusin']) {
    document.addEventListener(
      type,
      (e) => {
        const el = (e.target as Element | null)?.closest?.('.sref[data-ref]');
        if (el instanceof HTMLElement) load(el);
      },
      true,
    );
  }
</script>

<style is:global>
  .sref {
    position: relative;
    display: inline;
  }
  .sref-label {
    border-bottom: 1px dotted currentColor;
    cursor: help;
  }
  .sref:hover .sref-label,
  .sref:focus-visible .sref-label {
    color: var(--blue-deep);
  }

  .sref-pop {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 40;
    width: max-content;
    max-width: min(340px, 78vw);
    background: #fff;
    color: var(--navy);
    border: 1px solid var(--hair);
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 0.7rem 0.85rem;
    /* reset the small-caps caption styling inherited from .scripture */
    font-family: var(--body);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
    text-align: left;
    white-space: normal;
  }
  .sref:hover .sref-pop,
  .sref:focus .sref-pop,
  .sref:focus-within .sref-pop {
    display: block;
  }

  .sref-cite {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mid);
    font-style: normal;
  }
</style>
