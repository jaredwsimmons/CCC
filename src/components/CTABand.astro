---
// A call to action: heading, a line and buttons in a white panel at the end of a page.
interface Props { title: string; text?: string; }
const { title, text } = Astro.props;
---
<section class="section ctaband">
  <div class="wrap">
    <div class="panel inner" data-reveal>
      <div>
        <h2>{title}</h2>
        {text && <p>{text}</p>}
      </div>
      <div class="actions"><slot /></div>
    </div>
  </div>
</section>

<style>
  .ctaband h2 { max-width: 24ch; }
  .ctaband p { margin-top: 0.4rem; max-width: 52ch; color: var(--mid); }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
