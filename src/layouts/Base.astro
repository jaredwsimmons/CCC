---
import '../styles/global.css';
import { site, withBase } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChurchCenterScript from '../components/ChurchCenterScript.astro';
import ScriptureTooltips from '../components/ScriptureTooltips.astro';
import VisualEditing from '../components/VisualEditing.astro';
import { stegaClean } from '@sanity/client/stega';
import { isPreview, sanityFetch } from '../lib/sanity';
import { settingsQuery } from '../lib/queries';
import { pathFor, type LinkTarget } from '../lib/links';
import { hasEsvKey } from '../lib/esv';

interface Props {
  title?: string;
  description?: string;
}
// In preview these carry invisible click-to-edit marks, which don't belong in <head>.
const { title, description } = stegaClean(Astro.props);
const preview = await isPreview(Astro.cookies);

// The menu and the footer's church details come from Site Settings in Sanity.
type MenuEntry = { label: string; page?: LinkTarget; children?: MenuEntry[] | null };
const settings = await sanityFetch<any>(settingsQuery, {}, Astro.cookies);
const menu = ((settings?.menu ?? []) as MenuEntry[]).map((m) => ({
  label: m.label,
  href: pathFor(m.page) ?? '/',
  children: m.children?.length ? m.children.map((c) => ({ label: c.label, href: pathFor(c.page) ?? '/' })) : undefined,
}));
const churchName = settings?.churchName ?? '';
const fullTitle = title ? `${title} · ${churchName}` : `${churchName} — ${settings?.tagline ?? ''}`;
const metaDescription = description ?? settings?.description ?? '';
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#005291" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={churchName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />

    <!-- Brand type: Poppins (display, 500–700 per brand guide) + Nunito (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <!-- Progressive-enhancement flag: set BEFORE paint so reveal styles apply without FOUC. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <ChurchCenterScript />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header menu={menu} give={settings?.giveButton} churchName={churchName} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
    {hasEsvKey() && <ScriptureTooltips />}
    {preview && <VisualEditing />}

    <!-- Scroll-reveal. Progressive: content is fully visible if this never runs. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
          els.forEach(function (el) { io.observe(el); });
        }
      })();
    </script>

    <style is:global>
      .skip { position: absolute; left: -999px; top: 0; background: var(--navy); color: #fff; padding: 0.75rem 1rem; z-index: 100; border-radius: 0 0 8px 0; }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
