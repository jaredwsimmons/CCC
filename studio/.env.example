# Copy to studio/.env and fill in your Sanity project id (from https://www.sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Where the Live Preview tool shows the website (defaults to http://localhost:4321).
# Set this to the real site address before running `npx sanity deploy`.
SANITY_STUDIO_PREVIEW_URL=
